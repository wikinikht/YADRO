# Copy to .env (gitignored) and fill before `docker compose up`.
#   cp .env.example .env
#   openssl rand -hex 16   # paste into SECRET / SECRETS

TG_WS_PROXY_HOST=0.0.0.0
TG_WS_PROXY_PORT=1443

# 32 hex chars each. Leave empty only for a one-shot test (secret
# is random then and changes on every recreate).
TG_WS_PROXY_SECRET=
TG_WS_PROXY_SECRETS=

TG_WS_PROXY_DC_IPS=2:149.154.167.220 4:149.154.167.220
TG_WS_PROXY_FTLS_DOMAIN=cloudflare.com
TG_WS_PROXY_SOCKS5_ENABLED=True
TG_WS_PROXY_SOCKS5_HOST=0.0.0.0
TG_WS_PROXY_SOCKS5_PORT=1080
TG_WS_PROXY_CF_WORKER=
TG_WS_PROXY_NO_SECURE=False
